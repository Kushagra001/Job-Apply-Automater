# ── Required ──────────────────────────────────────────────────────────────────

# Groq API key (free tier — https://console.groq.com)
GROQ_API_KEY=gsk_...

# Google service account JSON (stringified, single line)
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SA_JSON={"type":"service_account","project_id":"..."}

# Google Sheets ID (the long string in the sheet URL)
# Share the sheet with the service account email as Editor
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ── Optional — Telegram notifications ─────────────────────────────────────────

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-...

# Your personal chat ID (get via @userinfobot)
TELEGRAM_CHAT_ID=123456789
