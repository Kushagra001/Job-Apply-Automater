# ── Required ──────────────────────────────────────────────────────────────────

# Groq API key (free tier — https://console.groq.com)
GROQ_API_KEY=gsk_...

# Google service account JSON (stringified, single line)
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SA_JSON={"type":"service_account","project_id":"..."}

# Google Sheets ID (the long string in the sheet URL)
# Share the sheet with the service account email as Editor
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ── Optional — Telegram notifications ─────────────────────────────────────────

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-...

# Your personal chat ID (get via @userinfobot)
TELEGRAM_CHAT_ID=123456789

# ── Optional — Pipeline tuning & email status tracking ────────────────────────

# Override default Groq fallback model order (active: openai/gpt-oss-20b, qwen/qwen3.8-27b, openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-20b

# Remote role optimization (set REMOTE_ONLY=true to filter exclusively for remote=True roles)
# REMOTE_ONLY=true
# REMOTE_FOCUS=true

# Cap scoring/apply candidates evaluated per pipeline run (default: 25)
# MAX_JOBS_PER_RUN=25

# Strict score threshold (0-100); defaults to 65 per AGENTS.md quality gate
# SCORE_TAILOR_THRESHOLD=65
# SCORE_VOLUME_FLOOR=65

# Maximum job posting age in days (stale listings older than this are skipped)
# MAX_JOB_AGE_DAYS=14

# Per-company cooldown & monthly application cap
# COOLDOWN_DAYS_PER_COMPANY=14
# MAX_APPLICATIONS_PER_COMPANY_30D=2

# Compensation defaults for ATS autofill custom questions
# EXPECTED_CTC_INR=800000 - 1200000 INR per annum (negotiable)
# EXPECTED_SALARY_USD=30000

# High-signal cold outreach drafts ([Gmail]/Drafts + output/outreach/)
# ENABLE_OUTREACH=true
# OUTREACH_SCORE_THRESHOLD=72

# Set to true to fill forms without clicking final Submit
# DRY_RUN=true

# Reuse local browser profile cookies across ATS forms
# PLAYWRIGHT_PERSISTENT_PROFILE=false

# Gmail IMAP credentials for track_applications.py & outreach.py drafts
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
